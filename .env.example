# Copy to .env (gitignored) and fill in. Only needed when config.yaml has `model: conch`.
# Use a token from an account that accepted the CONCH license on Hugging Face (rules.md §5).
HF_TOKEN=

# Request history (optional). A Postgres connection string, e.g. the Tiger Cloud service's URL from its
# console. Unset: history is kept in memory and lost on restart. Never commit the real value.
DATABASE_URL=
# Only for `make test-db`: a Postgres where the tests may create and drop a throwaway schema.
TEST_DATABASE_URL=
